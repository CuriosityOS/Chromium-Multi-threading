+
+ private:
+  void Run() override { std::move(task_).Run(); }
+
+  base::OnceClosure task_;
+};
+
+void RunConcurrently(base::RepeatingClosure task) {
+  base::WaitableEvent start;
+  QualifiedNameTestThread thread(base::BindLambdaForTesting([&] {
+    start.Wait();
+    task.Run();
+  }));
+  thread.Start();
+  start.Signal();
+  task.Run();
+  thread.Join();
+}
