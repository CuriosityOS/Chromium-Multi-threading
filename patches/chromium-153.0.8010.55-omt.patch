+  // The main thread is stuck in a long task while the page is changing.
+  void TakeOver() {
+    if (!channel_->ChangeMode(Mode::kMain, Mode::kRender)) {
+      return;
+    }
+    watchdog_.Stop();
+    ++takeovers_;
