+  // The main thread pushed journal entries or changed the mode.
+  void Wake() {
+    channel_->ClearWakePending();
+    if (channel_->GetMode() != Mode::kMain) {
+      presenting_ = true;
+      dispatcher_->SetNeedsBeginFrame(true);
+      return;
