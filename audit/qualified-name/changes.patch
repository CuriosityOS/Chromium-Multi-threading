+TEST_F(QualifiedNameTest, ConcurrentTriggerRegistrationAndReads) {
+  const AtomicString local("qualified-name-concurrent-trigger");
+  auto impl = QualifiedNameImpl::Create(nullptr, local.Impl(), nullptr, true);
+  // This test-only static impl is not interned and does not refcount. Destroy
+  // it explicitly after all handles and the reader thread have gone away.
+  std::unique_ptr<QualifiedNameImpl> owner(impl.get());
+  QualifiedName name{std::move(impl)};
+  const unsigned hash = name.Impl()->ComputeHash();
+  constexpr unsigned kIndex = QualifiedNameImpl::kLargestAllowedIndex;
+  base::WaitableEvent start;
+  QualifiedNameTestThread thread(base::BindLambdaForTesting([&] {
+    start.Wait();
+    for (int i = 0; i < 2000; ++i) {
+      QualifiedName copy{name};
+      EXPECT_TRUE(copy.IsDefinedName());
+      EXPECT_EQ(GetHash(copy), hash);
+      const auto index = copy.HTMLAttributeTriggersIndex();
+      EXPECT_TRUE(!index || *index == kIndex);
+    }
+  }));
+  thread.Start();
+  start.Signal();
+  name.RegisterHTMLAttributeTriggersIndex(kIndex);
+  thread.Join();
+  EXPECT_EQ(name.HTMLAttributeTriggersIndex(), kIndex);
+  EXPECT_TRUE(name.IsDefinedName());
+  EXPECT_EQ(GetHash(name), hash);
+}
