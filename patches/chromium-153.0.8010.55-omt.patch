+  const unsigned hash = name.Impl()->ComputeHash();
+  RunConcurrently(base::BindLambdaForTesting([&] {
+    for (int i = 0; i < 2000; ++i) {
+      QualifiedName copy{name};
+      EXPECT_EQ(GetHash(copy), hash);
+      EXPECT_EQ(copy.LocalNameUpper(), upper);
+      EXPECT_EQ(&copy.LocalNameUpper(), &name.LocalNameUpperSlow());
+      EXPECT_EQ(copy, QualifiedName(name.LocalName()));
+      EXPECT_FALSE(copy.IsDefinedName());
