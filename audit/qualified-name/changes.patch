+TEST_F(QualifiedNameTest, UppercaseAndHash) {
+  for (const auto& local :
+       {AtomicString(), AtomicString(""), AtomicString("already-UPPER"),
+        AtomicString(u"a\u00e9\u03a9z")}) {
+    QualifiedName name{local};
+    EXPECT_EQ(name.LocalNameUpper(), local.ToAsciiUpper());
+    EXPECT_EQ(name.LocalNameUpper().IsNull(), local.IsNull());
+    EXPECT_EQ(&name.LocalNameUpper(), &name.LocalNameUpperSlow());
+    EXPECT_EQ(GetHash(name), name.Impl()->ComputeHash());
+    EXPECT_EQ(name, QualifiedName(g_null_atom, local, g_empty_atom));
+    EXPECT_FALSE(name.HTMLAttributeTriggersIndex().has_value());
+  }
+}
+
+// Run these concurrent tests under TSan as well: equal results do not make
+// concurrent writes to an interned impl's derived values safe.
+TEST_F(QualifiedNameTest, ConcurrentSharedImplReadsAndCopies) {
+  QualifiedName name{AtomicString("qualified-name-concurrent-read")};
+  const AtomicString upper("QUALIFIED-NAME-CONCURRENT-READ");
+  const unsigned hash = name.Impl()->ComputeHash();
+  RunConcurrently(base::BindLambdaForTesting([&] {
+    for (int i = 0; i < 2000; ++i) {
+      QualifiedName copy{name};
+      EXPECT_EQ(GetHash(copy), hash);
+      EXPECT_EQ(copy.LocalNameUpper(), upper);
+      EXPECT_EQ(&copy.LocalNameUpper(), &name.LocalNameUpperSlow());
+      EXPECT_EQ(copy, QualifiedName(name.LocalName()));
+      EXPECT_FALSE(copy.IsDefinedName());
+    }
+  }));
+  EXPECT_TRUE(name.Impl()->HasOneRef());
+}
+
+TEST_F(QualifiedNameTest, ConcurrentInterningAndLastRelease) {
+  const AtomicString local("qualified-name-concurrent-last-release");
+  const AtomicString upper("QUALIFIED-NAME-CONCURRENT-LAST-RELEASE");
+  // Do not retain an anchor QualifiedName: either thread may remove the last
+  // impl while the other thread is looking up the same cache entry.
+  RunConcurrently(base::BindLambdaForTesting([&] {
+    for (int i = 0; i < 2000; ++i) {
+      QualifiedName name{local};
+      QualifiedName copy{name};
+      EXPECT_EQ(name, QualifiedName(local));
+      EXPECT_EQ(GetHash(copy), name.Impl()->ComputeHash());
+      EXPECT_EQ(copy.LocalNameUpper(), upper);
+    }
+  }));
+}
